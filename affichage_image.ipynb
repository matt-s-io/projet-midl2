    "\n",
    "\n",
    "\n",
    "r = int(input(\"Entrez un id d'image\"))\n",
    "\n",
    "X_test = images.load_mnist_idx(\"data/t10k-images.idx3-ubyte\")\n",
    "\n",
    "\n",
    "\n",
    "img = np.reshape(X_test[r], (28, 28))\n",
    "plt.imshow(img, cmap=\"gray\")\n",
    "plt.axis('off')\n",
    "plt.show()\n"
   ]
